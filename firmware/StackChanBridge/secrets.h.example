#pragma once

// Copy this file to `secrets.h` and fill in real values.
// `secrets.h` is gitignored — it must never be committed.

// WiFi
#define WIFI_SSID "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// n8n webhook for outbound StackChan events (touch / button / IMU shake).
// Optional — comment out or leave a dummy URL if you aren't forwarding events.
#define N8N_EVENT_URL "https://your-n8n-host/webhook/stackchan-events"

// HTTP API listen port on the device.
#define HTTP_PORT 80

// mDNS hostname → http://<MDNS_HOSTNAME>.local/ if your network resolves mDNS.
#define MDNS_HOSTNAME "stackchan"

// OTA password. Required to flash over WiFi (espota / arduino-cli network upload).
#define OTA_PASSWORD "change-me"
